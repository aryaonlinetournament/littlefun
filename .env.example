# ─────────────────────────────────────────────────────────────────
# LittleFun V2 — Environment Variables
# Copy to .env.local (development) or set in your hosting dashboard
# NEVER commit real secrets to git
# ─────────────────────────────────────────────────────────────────

# Node Environment
NODE_ENV=development
PORT=3001

# ── Firebase (Server-side / Admin SDK) ────────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
# Or path to the JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ── Super Admin Security Override ────────────────────────────────
# Set your exact Firebase User UID here for maximum security:
SUPER_ADMIN_UID=your-firebase-user-uid
SUPER_ADMIN_EMAIL=aryaonlinetournament@gmail.com

# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Service role key — ONLY on backend, never in frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Anon key — safe for frontend (enforced by RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Firebase Cloud Messaging ───────────────────────────────────────
# Used by NotificationService on backend
FCM_SERVER_KEY=your-fcm-server-key

# ── Frontend (Vite injects these at build time) ────────────────────
# Customer app (.env in apps/customer/)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:3001

# ── Admin App ─────────────────────────────────────────────────────
# Admin app uses same Firebase project, checked role server-side
VITE_ADMIN_API_BASE_URL=http://localhost:3001

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://customer.littlefun.in,https://admin.littlefun.in

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
